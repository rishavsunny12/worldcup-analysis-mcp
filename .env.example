# Required API keys
API_FOOTBALL_KEY=your_api_football_key_here
FOOTBALL_DATA_KEY=your_football_data_key_here

# Tier routing: "free" during dev, "paid" from June 11 onward
API_FOOTBALL_TIER=free

# Public base URL — set to your Railway deployment URL (no trailing slash)
# e.g. https://worldcup-analysis-mcp.up.railway.app
BASE_URL=

# Cache TTLs (seconds) — defaults shown
CACHE_TTL_LIVE=30
CACHE_TTL_LINEUPS=300
CACHE_TTL_FORM=3600
CACHE_TTL_FIXTURES=86400
CACHE_TTL_STANDINGS=300
CACHE_TTL_H2H=3600
CACHE_TTL_SCORERS=300
