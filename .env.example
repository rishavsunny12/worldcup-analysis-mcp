# Required API keys
API_FOOTBALL_KEY=your_api_football_key_here
FOOTBALL_DATA_KEY=your_football_data_key_here
BZZOIRO_KEY=your_bzzoiro_key_here

# Tier routing: "free" during dev, "paid" from June 11 onward
API_FOOTBALL_TIER=free

# Live tournament data: "bzzoiro" (default) or "legacy" (API-Football / football-data.org)
LIVE_DATA_SOURCE=bzzoiro

# Public base URL — only needed for local OAuth testing (Railway sets this automatically)
# BASE_URL=https://your-app.up.railway.app

# OAuth token persistence (survives redeploys when backed by a Railway volume at /data)
# OAUTH_DB_PATH=/data/oauth.db

# Cache TTLs (seconds) — defaults shown
CACHE_TTL_LIVE=30
CACHE_TTL_LINEUPS=300
CACHE_TTL_FORM=3600
CACHE_TTL_FIXTURES=86400
CACHE_TTL_STANDINGS=300
CACHE_TTL_H2H=3600
CACHE_TTL_SCORERS=300
